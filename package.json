{
  "name": "agentmeter",
  "version": "0.1.0",
  "description": "Electricity meter + usage audit + quota alert for coding agents (Claude Code, ZCode, Codex, OpenCode). 100% local, zero telemetry, zero runtime deps.",
  "type": "module",
  "bin": {
    "agentmeter": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "pricing",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "claude-code",
    "zcode",
    "codex",
    "opencode",
    "token-usage",
    "cost-tracking",
    "coding-agent",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
